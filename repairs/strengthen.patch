+#[test]
+fn deterministic_wire_encoding_ignores_observation_order() {
+    let r1 = Uuid::new_v4();
+    let r2 = Uuid::new_v4();
+    let dots = [causalmesh::Dot::new(r1, 2).unwrap(), causalmesh::Dot::new(r2, 1).unwrap(), causalmesh::Dot::new(r1, 1).unwrap()];
+    let mut a = CausalContext::default();
+    let mut b = CausalContext::default();
+    for dot in dots { a.observe(dot).unwrap(); }
+    for dot in dots.into_iter().rev() { b.observe(dot).unwrap(); }
+    let peer = Uuid::new_v4();
+    let ma = WireMessage::Summary { version: WIRE_VERSION, replica_id: peer, seen: a };
+    let mb = WireMessage::Summary { version: WIRE_VERSION, replica_id: peer, seen: b };
+    assert_eq!(ma.encode().unwrap(), mb.encode().unwrap());
+}
