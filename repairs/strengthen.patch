+#[test]
+fn deterministic_pairwise_gossip_converges_five_replicas() {
+    let dirs: Vec<TempDir> = (0..5).map(|_| TempDir::new().unwrap()).collect();
+    let mut replicas: Vec<Replica> = dirs.iter().map(|d| Replica::init(d.path()).unwrap()).collect();
+    for (i, replica) in replicas.iter_mut().enumerate() { replica.put(format!("k{i}"), vec![i as u8]).unwrap(); }
+    let schedule = [(0,1),(2,3),(1,4),(0,2),(3,4),(1,3),(0,4),(2,4),(0,3),(1,2)];
+    for _ in 0..3 {
+        for &(i,j) in &schedule {
+            let (left,right) = replicas.split_at_mut(j.max(i));
+            if i < j { sync_bidirectional(&mut left[i], &mut right[0]).unwrap(); }
+            else { sync_bidirectional(&mut right[0], &mut left[j]).unwrap(); }
+        }
+    }
+    let state = replicas[0].logical_state();
+    for replica in &replicas { assert_eq!(state, replica.logical_state()); }
+}
