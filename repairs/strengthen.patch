+#[test]
+fn malformed_batch_failure_survives_reopen_without_partial_commit() {
+    let (dir, mut r) = fresh();
+    let remote = Uuid::new_v4();
+    let good = Operation { id: causalmesh::Dot::new(remote, 1).unwrap(), context: CausalContext::default(), key: "ok".into(), kind: OpKind::Put(b"v".to_vec()) };
+    let bad = Operation { id: causalmesh::Dot::new(remote, 2).unwrap(), context: CausalContext::default(), key: String::new(), kind: OpKind::Put(b"bad".to_vec()) };
+    assert!(r.receive_batch(&[good, bad]).is_err());
+    drop(r);
