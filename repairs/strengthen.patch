+#[test]
+fn star_topology_converges() {
+    let (_dc, mut center) = fresh();
+    let leaf_dirs: Vec<TempDir> = (0..4).map(|_| TempDir::new().unwrap()).collect();
+    let mut leaves: Vec<Replica> = leaf_dirs.iter().map(|d| Replica::init(d.path()).unwrap()).collect();
+    center.put("center", b"c".to_vec()).unwrap();
+    for (i, leaf) in leaves.iter_mut().enumerate() { leaf.put(format!("leaf:{i}"), vec![i as u8]).unwrap(); }
+    for _ in 0..2 {
+        for leaf in &mut leaves { sync_bidirectional(&mut center, leaf).unwrap(); }
+    }
+    for leaf in &leaves { assert_eq!(center.logical_state(), leaf.logical_state()); }
