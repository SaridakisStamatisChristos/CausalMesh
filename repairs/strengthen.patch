+    c.put("c", b"3".to_vec()).unwrap();
+    for _ in 0..3 {
+        sync_bidirectional(&mut a, &mut b).unwrap();
+        sync_bidirectional(&mut b, &mut c).unwrap();
+    }
+    assert_eq!(a.logical_state(), b.logical_state());
+    assert_eq!(b.logical_state(), c.logical_state());
+}
